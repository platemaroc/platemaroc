# Variables del script de backup (config/backups/backup-db.sh). Archivo real: /etc/platemaroc/backup.env (permisos 600, fuera del repo).
# Usar un rol de base de datos de SOLO LECTURA para el volcado.
DATABASE_URL=
# Clave PÚBLICA de `age` (empieza por age1...). La clave privada NO está en el servidor.
AGE_RECIPIENT=
BACKUP_DIR=/var/backups/platemaroc
# Copia externa (opcional pero recomendada): destino de rclone, p. ej. remoto:carpeta
OFFSITE_REMOTE=
# Comando que se ejecuta si el backup falla; recibe el mensaje por stdin (p. ej. un envío de email).
ALERT_CMD=
