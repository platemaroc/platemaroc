# Plantilla de variables de entorno. SOLO nombres: nunca pongas valores reales en este archivo ni en Git.
# Copia a .env.local (desarrollo) o al archivo de entorno del servidor (/etc/platemaroc/app.env) y rellena los valores allí.
# El titular gestiona las claves (maestro §2). Los secretos reales viven en su gestor seguro.
# Las variables NEXT_PUBLIC_ se graban al construir: al desplegar se leen de las variables de GitHub (config/deploy), además de aquí.
# DATABASE_URL y DATABASE_PASSWORD no van en /etc/platemaroc/app.env: la web no las usa.

# --- Sitio
NEXT_PUBLIC_SITE_URL=https://platemaroc.com

# --- Supabase (misma región de Europa que el servidor)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO. Solo servidor/scripts. NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión SIN contraseña (Supabase: Connect > Session pooler, quitando ":[YOUR-PASSWORD]"). Solo para codigo/database/apply.sh.
DATABASE_URL=
# SECRETO. Contraseña de la base de datos, sola y sin comillas. apply.sh la usa junto con DATABASE_URL.
DATABASE_PASSWORD=

# --- Alta pública de cuentas con Google: 1 = abierta. NO activar en producción hasta tener la política de privacidad (docs/08).
PUBLIC_SIGNUP_ENABLED=

# --- Interruptor de indexación: 1 = Google puede indexar lo que pase el Quality Gate. Apagado: noindex en todo y robots.txt bloquea.
# Encender solo en producción, al lanzar la web, por decisión del titular.
SITE_INDEXING_ENABLED=

# --- Mapas (clave restringida por dominio/referrer y por API en la consola del proveedor)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Notificaciones por email (MVP: email + panel)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Login por teléfono: solo si se mantiene ese método (proveedor de SMS pendiente, docs/08)
# SMS_PROVIDER_API_KEY=
