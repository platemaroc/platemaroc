name: deploy
on:
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production        # configurar revisores obligatorios: publicar requiere aprobación del titular
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - run: npm test --if-present
      - run: npm run build
      - name: Escáner de secretos
        run: node codigo/security/scan-secrets.mjs .
      - name: Subir release y activar
        env:
          DEPLOY_SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          DEPLOY_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
          HOST: ${{ secrets.DEPLOY_HOST }}
          USER_: ${{ secrets.DEPLOY_USER }}
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\n' "$DEPLOY_SSH_KEY" > ~/.ssh/id_deploy && chmod 600 ~/.ssh/id_deploy
          printf '%s\n' "$DEPLOY_KNOWN_HOSTS" > ~/.ssh/known_hosts
          REL="/srv/platemaroc/releases/${GITHUB_SHA}"
          SSH="ssh -i ~/.ssh/id_deploy $USER_@$HOST"
          $SSH "mkdir -p $REL"
          rsync -az -e "ssh -i ~/.ssh/id_deploy" ./build-output/ "$USER_@$HOST:$REL/"   # ajustar a la salida real del build
          $SSH "PREV=\$(readlink -f /srv/platemaroc/current || true); ln -sfn $REL /srv/platemaroc/current && sudo systemctl restart platemaroc && sleep 3 && curl -fsS http://127.0.0.1:3000/ >/dev/null || { [ -n \"\$PREV\" ] && ln -sfn \"\$PREV\" /srv/platemaroc/current && sudo systemctl restart platemaroc; exit 1; }"
          $SSH "ls -1dt /srv/platemaroc/releases/* | tail -n +6 | xargs -r rm -rf"
