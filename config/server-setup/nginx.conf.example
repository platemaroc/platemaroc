# Plantilla. Adaptar dominios/rutas. Las cabeceras de seguridad y de caché (HSTS, CSP, sw.js...) las envía la aplicación: no duplicarlas aquí.
# Límite por IP, además del de la aplicación (backend/auth/rate-limit.ts). Este archivo se incluye dentro del bloque http de Nginx.
limit_req_zone $binary_remote_addr zone=platemaroc:10m rate=10r/s;

server {
  listen 80;
  server_name platemaroc.com www.platemaroc.com;

  # Certbot renueva el certificado por aquí: esta ruta no se redirige
  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://platemaroc.com$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name platemaroc.com www.platemaroc.com;

  # Certbot crea estos archivos (config/server-setup/README.md, paso 12)
  ssl_certificate     /etc/letsencrypt/live/platemaroc.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/platemaroc.com/privkey.pem;

  if ($host = www.platemaroc.com) { return 301 https://platemaroc.com$request_uri; }

  # Fotos del panel: hasta 10 MB por imagen más el margen del formulario (next.config.ts). Por defecto Nginx corta en 1 MB.
  client_max_body_size 12m;

  gzip on;
  gzip_proxied any;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Se heredan en los dos location. Host es necesario: Next.js lo compara con Origin en los formularios.
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  # Estáticos con hash en el nombre: sin límite, una página pide muchos a la vez
  location /_next/static/ {
    proxy_pass http://127.0.0.1:3000;
  }

  location / {
    limit_req zone=platemaroc burst=40 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3000;
  }
}
