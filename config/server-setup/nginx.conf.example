# Plantilla. Adaptar dominios/rutas. Las cabeceras de seguridad (HSTS, CSP...) las envía la aplicación: no duplicarlas aquí.
server {
  listen 80;
  server_name platemaroc.com www.platemaroc.com;
  return 301 https://platemaroc.com$request_uri;
}

server {
  listen 443 ssl http2;
  server_name platemaroc.com www.platemaroc.com;

  # Certbot rellena/gestiona estas rutas
  ssl_certificate     /etc/letsencrypt/live/platemaroc.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/platemaroc.com/privkey.pem;

  if ($host = www.platemaroc.com) { return 301 https://platemaroc.com$request_uri; }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # El Service Worker nunca debe quedar cacheado por el navegador/CDN (actualizaciones versionadas)
  location = /sw.js {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    add_header Cache-Control "no-cache" always;
  }

  # Estáticos con hash en el nombre: caché larga
  location /_next/static/ {
    proxy_pass http://127.0.0.1:3000;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
