[Unit]
Description=Platemaroc (Next.js)
After=network.target

[Service]
User=deploy
# Salida standalone con la raíz en el repositorio: server.js queda en esta subcarpeta (codigo/frontend/scripts/package-release.mjs)
WorkingDirectory=/srv/platemaroc/current/codigo/frontend
EnvironmentFile=/etc/platemaroc/app.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
